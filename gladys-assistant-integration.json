{
  "manifest_version": 1,
  "type": "device",
  "name": "Forecast.Solar",
  "description": {
    "en": "Solar production forecast for your PV panels: power now, energy today and tomorrow.",
    "fr": "Prévision de production solaire : puissance actuelle, énergie du jour et du lendemain.",
    "de": "Solarertragsprognose für deine PV-Anlage: aktuelle Leistung, Energie heute und morgen.",
    "es": "Previsión de producción solar de sus paneles: potencia actual, energía de hoy y mañana."
  },
  "version": "1.5.0",
  "docker_image": "ghcr.io/prohand/gladys-forecastsolar:1.5.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-forecastsolar/main/cover.png",
  "categories": ["energy"],
  "keywords": [
    "photovoltaic",
    "photovoltaïque",
    "photovoltaik",
    "fotovoltaica",
    "solar panels",
    "panneaux solaires",
    "solar estimate",
    "kwp",
    "pv yield"
  ],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "The forecast uses the location of your houses in Gladys (Settings > Houses): one device per located house, add only the ones with solar panels. Then describe the panels below. Free plan: no account, 12 requests per hour.",
        "fr": "La prévision utilise la position de vos maisons dans Gladys (Paramètres > Maisons) : un appareil par maison localisée, n'ajoutez que celles qui ont des panneaux. Décrivez ensuite les panneaux ci-dessous. Offre gratuite : sans compte, 12 requêtes par heure.",
        "de": "Die Prognose nutzt den Standort deiner Häuser in Gladys (Einstellungen > Zuhause): ein Gerät pro Haus mit Standort, füge nur die mit Solarmodulen hinzu. Beschreibe anschließend unten die Module. Kostenloser Tarif: kein Konto, 12 Anfragen pro Stunde.",
        "es": "La previsión utiliza la ubicación de sus viviendas en Gladys (Configuración > Viviendas): un dispositivo por vivienda ubicada, añada solo las que tienen paneles solares. Después describa los paneles a continuación. Plan gratuito: sin cuenta, 12 solicitudes por hora."
      },
      "links": [
        {
          "url": "https://forecast.solar",
          "label": {
            "en": "Forecast.Solar website",
            "fr": "Site de Forecast.Solar",
            "de": "Website von Forecast.Solar",
            "es": "Sitio web de Forecast.Solar"
          }
        },
        {
          "url": "https://doc.forecast.solar/api:estimate",
          "label": {
            "en": "API documentation",
            "fr": "Documentation de l'API",
            "de": "API-Dokumentation",
            "es": "Documentación de la API"
          }
        }
      ]
    },
    {
      "key": "declination",
      "type": "number",
      "label": {
        "en": "Tilt (°)",
        "fr": "Inclinaison (°)",
        "de": "Neigung (°)",
        "es": "Inclinación (°)"
      },
      "description": {
        "en": "Angle of the panels: 0 = flat, 90 = vertical.",
        "fr": "Angle des panneaux : 0 = à plat, 90 = vertical.",
        "de": "Neigungswinkel der Module: 0 = flach, 90 = senkrecht.",
        "es": "Ángulo de los paneles: 0 = horizontal, 90 = vertical."
      },
      "required": true,
      "default": 35,
      "min": 0,
      "max": 90
    },
    {
      "key": "azimuth",
      "type": "number",
      "label": {
        "en": "Orientation (°)",
        "fr": "Orientation (°)",
        "de": "Ausrichtung (°)",
        "es": "Orientación (°)"
      },
      "description": {
        "en": "Direction the panels face: 0 = south, -90 = east, 90 = west, 180 = north.",
        "fr": "Direction des panneaux : 0 = sud, -90 = est, 90 = ouest, 180 = nord.",
        "de": "Himmelsrichtung der Module: 0 = Süden, -90 = Osten, 90 = Westen, 180 = Norden.",
        "es": "Dirección de los paneles: 0 = sur, -90 = este, 90 = oeste, 180 = norte."
      },
      "required": true,
      "default": 0,
      "min": -180,
      "max": 180
    },
    {
      "key": "wp",
      "type": "number",
      "label": {
        "en": "Peak power (Wp)",
        "fr": "Puissance crête (Wc)",
        "de": "Spitzenleistung (Wp)",
        "es": "Potencia pico (Wp)"
      },
      "description": {
        "en": "Installed peak power of the panels, in watt-peak (whole number), e.g. 3000 for 3 kWp or 6200 for 6.2 kWp.",
        "fr": "Puissance crête installée des panneaux, en watt-crête (nombre entier), par exemple 3000 pour 3 kWc ou 6200 pour 6,2 kWc.",
        "de": "Installierte Spitzenleistung der Module in Watt-Peak (ganze Zahl), z. B. 3000 für 3 kWp oder 6200 für 6,2 kWp.",
        "es": "Potencia pico instalada de los paneles, en vatios pico (número entero), p. ej. 3000 para 3 kWp o 6200 para 6,2 kWp."
      },
      "required": true,
      "min": 10,
      "max": 10000000
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key (optional)",
        "fr": "Clé d'API (facultative)",
        "de": "API-Schlüssel (optional)",
        "es": "Clave de API (opcional)"
      },
      "description": {
        "en": "Leave empty for the free plan.",
        "fr": "Laissez vide pour l'offre gratuite.",
        "de": "Für den kostenlosen Tarif leer lassen.",
        "es": "Déjela vacía para el plan gratuito."
      },
      "required": false
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Forecast refresh interval (min)",
        "fr": "Intervalle de mise à jour de la prévision (min)",
        "de": "Aktualisierungsintervall der Prognose (min)",
        "es": "Intervalo de actualización de la previsión (min)"
      },
      "description": {
        "en": "How often the forecast is downloaded again. The values shown in Gladys are still updated every 5 minutes.",
        "fr": "Fréquence de téléchargement de la prévision. Les valeurs affichées dans Gladys restent mises à jour toutes les 5 minutes.",
        "de": "Wie oft die Prognose neu heruntergeladen wird. Die in Gladys angezeigten Werte werden trotzdem alle 5 Minuten aktualisiert.",
        "es": "Frecuencia con la que se vuelve a descargar la previsión. Los valores mostrados en Gladys se siguen actualizando cada 5 minutos."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 1440
    }
  ],
