  "scene_actions": [
    {
      "key": "get_forecast",
      "label": {
        "en": "Read the solar forecast",
        "fr": "Lire la prévision solaire"
      },
      "description": {
        "en": "Values of the forecast, usable in the next actions and conditions.",
        "fr": "Valeurs de la prévision, utilisables dans les actions et conditions suivantes."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Solar forecast",
            "fr": "Prévision solaire"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "power_now",
          "type": "number",
          "label": {
            "en": "Estimated power now (W)",
            "fr": "Puissance estimée actuelle (W)"
          }
        },
        {
          "key": "energy_today",
          "type": "number",
          "label": {
            "en": "Estimated energy today (kWh)",
            "fr": "Énergie estimée aujourd'hui (kWh)"
          }
        },
        {
          "key": "energy_remaining_today",
          "type": "number",
          "label": {
            "en": "Estimated energy remaining today (kWh)",
            "fr": "Énergie estimée restante aujourd'hui (kWh)"
          }
        },
        {
          "key": "energy_tomorrow",
          "type": "number",
          "label": {
            "en": "Estimated energy tomorrow (kWh)",
            "fr": "Énergie estimée demain (kWh)"
          }
        },
        {
          "key": "peak_power",
          "type": "number",
          "label": {
            "en": "Peak power of the day (W)",
            "fr": "Puissance du pic de la journée (W)"
          }
        },
        {
          "key": "peak_time",
          "type": "string",
          "label": {
            "en": "Time of the peak (HH:MM)",
            "fr": "Heure du pic (HH:MM)"
          }
        }
      ]
    },
    {
      "key": "get_production_next_hours",
      "label": {
        "en": "Solar production in the next hours",
        "fr": "Production solaire des prochaines heures"
      },
      "description": {
        "en": "Estimated energy produced from now over the chosen number of hours.",
        "fr": "Énergie estimée produite à partir de maintenant sur le nombre d'heures choisi."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Solar forecast",
            "fr": "Prévision solaire"
          },
          "required": true
        },
        {
          "key": "hours",
          "type": "number",
          "label": {
            "en": "Hours",
            "fr": "Heures"
          },
          "required": true,
          "default": 3,
          "min": 1,
          "max": 48
        }
      ],
      "outputs": [
        {
          "key": "energy",
          "type": "number",
          "label": {
            "en": "Estimated energy (kWh)",
            "fr": "Énergie estimée (kWh)"
          }
        },
        {
          "key": "average_power",
          "type": "number",
          "label": {
            "en": "Average power (W)",
            "fr": "Puissance moyenne (W)"
          }
        },
        {
          "key": "max_power",
          "type": "number",
          "label": {
            "en": "Maximum power (W)",
            "fr": "Puissance maximale (W)"
          }
        }
      ]
    },
    {
      "key": "find_best_window",
      "label": {
        "en": "Find the best solar time slot",
        "fr": "Trouver le meilleur créneau solaire"
      },
      "description": {
        "en": "Best moment to run an appliance of the given duration on solar power.",
        "fr": "Meilleur moment pour faire tourner un appareil de la durée choisie sur le solaire."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Solar forecast",
            "fr": "Prévision solaire"
          },
          "required": true
        },
        {
          "key": "duration_hours",
          "type": "number",
          "label": {
            "en": "Duration (hours)",
            "fr": "Durée (heures)"
          },
          "required": true,
          "default": 2,
          "min": 0.25,
          "max": 12
        },
        {
          "key": "day",
          "type": "select",
          "label": {
            "en": "Day",
            "fr": "Jour"
          },
          "required": true,
          "default": "today",
          "display": "radio",
          "options": [
            {
              "value": "today",
              "label": {
                "en": "Today (from now)",
                "fr": "Aujourd'hui (à partir de maintenant)"
              }
            },
            {
              "value": "tomorrow",
              "label": {
                "en": "Tomorrow",
                "fr": "Demain"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "found",
          "type": "boolean",
          "label": {
            "en": "Slot found",
            "fr": "Créneau trouvé"
          }
        },
        {
          "key": "start_time",
          "type": "string",
          "label": {
            "en": "Start time (HH:MM)",
            "fr": "Heure de début (HH:MM)"
          }
        },
        {
          "key": "end_time",
          "type": "string",
          "label": {
            "en": "End time (HH:MM)",
            "fr": "Heure de fin (HH:MM)"
          }
        },
        {
          "key": "energy",
          "type": "number",
          "label": {
            "en": "Estimated energy in the slot (kWh)",
            "fr": "Énergie estimée sur le créneau (kWh)"
          }
        },
        {
          "key": "minutes_until_start",
          "type": "number",
          "label": {
            "en": "Minutes until the start",
            "fr": "Minutes avant le début"
          }
        }
      ]
    }
