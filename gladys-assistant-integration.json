{
  "manifest_version": 1,
  "type": "device",
  "name": "Forecast.Solar",
  "description": {
    "en": "Solar production forecast for your PV panels: power now, energy today and tomorrow.",
    "fr": "Prévision de production solaire : puissance actuelle, énergie du jour et du lendemain."
  },
  "version": "1.2.0",
  "docker_image": "ghcr.io/prohand/gladys-forecastsolar:1.2.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-forecastsolar/main/cover.png",
  "categories": ["energy"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "The forecast uses the location of your houses in Gladys (Settings > Houses): one device per located house, add only the ones with solar panels. Then describe the panels below. Free plan: no account, 12 requests per hour.",
        "fr": "La prévision utilise la position de vos maisons dans Gladys (Paramètres > Maisons) : un appareil par maison localisée, n'ajoutez que celles qui ont des panneaux. Décrivez ensuite les panneaux ci-dessous. Offre gratuite : sans compte, 12 requêtes par heure."
      },
      "links": [
        {
          "url": "https://forecast.solar",
          "label": {
            "en": "Forecast.Solar website",
            "fr": "Site de Forecast.Solar"
          }
        },
        {
          "url": "https://doc.forecast.solar/api:estimate",
          "label": {
            "en": "API documentation",
            "fr": "Documentation de l'API"
          }
        }
      ]
    },
    {
      "key": "declination",
      "type": "number",
      "label": {
        "en": "Tilt (°)",
        "fr": "Inclinaison (°)"
      },
      "description": {
        "en": "Angle of the panels: 0 = flat, 90 = vertical.",
        "fr": "Angle des panneaux : 0 = à plat, 90 = vertical."
      },
      "required": true,
      "default": 35,
      "min": 0,
      "max": 90
    },
    {
      "key": "azimuth",
      "type": "number",
      "label": {
        "en": "Orientation (°)",
        "fr": "Orientation (°)"
      },
      "description": {
        "en": "Direction the panels face: 0 = south, -90 = east, 90 = west, 180 = north.",
        "fr": "Direction des panneaux : 0 = sud, -90 = est, 90 = ouest, 180 = nord."
      },
      "required": true,
      "default": 0,
      "min": -180,
      "max": 180
    },
    {
      "key": "wp",
      "type": "number",
      "label": {
        "en": "Peak power (Wp)",
        "fr": "Puissance crête (Wc)"
      },
      "description": {
        "en": "Installed peak power of the panels, in watt-peak (whole number), e.g. 3000 for 3 kWp or 6200 for 6.2 kWp.",
        "fr": "Puissance crête installée des panneaux, en watt-crête (nombre entier), par exemple 3000 pour 3 kWc ou 6200 pour 6,2 kWc."
      },
      "required": true,
      "min": 10,
      "max": 10000000
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key (optional)",
        "fr": "Clé d'API (facultative)"
      },
      "description": {
        "en": "Leave empty for the free plan.",
        "fr": "Laissez vide pour l'offre gratuite."
      },
      "required": false
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Forecast refresh interval (min)",
        "fr": "Intervalle de mise à jour de la prévision (min)"
      },
      "description": {
        "en": "How often the forecast is downloaded again. The values shown in Gladys are still updated every 5 minutes.",
        "fr": "Fréquence de téléchargement de la prévision. Les valeurs affichées dans Gladys restent mises à jour toutes les 5 minutes."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 1440
    }
  ],
  "actions": [
    {
      "key": "test_forecast",
      "label": {
        "en": "Refresh the forecast now",
        "fr": "Mettre à jour la prévision maintenant"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "forecast_updated",
      "label": {
        "en": "Solar forecast updated",
        "fr": "Prévision solaire mise à jour"
      },
      "description": {
        "en": "A new forecast was downloaded (every refresh interval).",
        "fr": "Une nouvelle prévision a été téléchargée (à chaque intervalle de mise à jour)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Solar forecast",
            "fr": "Prévision solaire"
          },
          "description": {
            "en": "Leave empty for any house.",
            "fr": "Laissez vide pour toutes les maisons."
          }
        }
      ],
      "variables": [
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          }
        },
        {
          "key": "power_now",
          "type": "number",
          "label": {
            "en": "Estimated power now (W)",
            "fr": "Puissance estimée actuelle (W)"
          }
        },
        {
          "key": "energy_today",
          "type": "number",
          "label": {
            "en": "Estimated energy today (kWh)",
            "fr": "Énergie estimée aujourd'hui (kWh)"
          }
        },
        {
          "key": "energy_remaining_today",
          "type": "number",
          "label": {
            "en": "Estimated energy remaining today (kWh)",
            "fr": "Énergie estimée restante aujourd'hui (kWh)"
          }
        },
        {
          "key": "energy_tomorrow",
          "type": "number",
          "label": {
            "en": "Estimated energy tomorrow (kWh)",
            "fr": "Énergie estimée demain (kWh)"
          }
        },
        {
          "key": "peak_power",
          "type": "number",
          "label": {
            "en": "Peak power of the day (W)",
            "fr": "Puissance du pic de la journée (W)"
          }
        },
        {
          "key": "peak_time",
          "type": "string",
          "label": {
            "en": "Time of the peak (HH:MM)",
            "fr": "Heure du pic (HH:MM)"
          }
        }
      ]
    },
